# --- Server (copy to server/.env) ---
PORT=3001
NODE_ENV=development

# Space-Track.org (optional but needed for the debris catalog).
# Register at https://www.space-track.org/ and accept the user agreement.
SPACE_TRACK_USER=
SPACE_TRACK_PASSWORD=

# Launch Library 2: "dev" uses lldev.thespacedevs.com (sample data, generous limits).
# "prod" uses ll.thespacedevs.com — 15 requests/hour; OrbitWatch caches aggressively.
LL2_MODE=dev

# Watchlist databases (Exp 7: SQL + NoSQL CRUD)
# SQLite file — defaults to server/data/watchlist.db
SQLITE_FILE=
# MongoDB. Blank, or a localhost URI with nothing listening, starts an embedded mongod
# on that port (default 27017; data in server/data/mongo) — point Compass at it.
# An installed MongoDB on that port, or an Atlas URI, is used directly.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=orbitwatch

# Catalog cache TTLs (milliseconds)
CELESTRAK_TTL_MS=21600000
SPACE_TRACK_TTL_MS=43200000
NOAA_TTL_MS=600000
LL2_TTL_MS=1800000

# --- Client (copy to client/.env) ---
# Free Cesium ion token: https://ion.cesium.com/tokens
# Paste the token, then restart the Vite client (npm run dev).
VITE_CESIUM_ION_TOKEN=
VITE_API_BASE=
